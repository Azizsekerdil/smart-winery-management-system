# =============================================================================
#  Akıllı Şaraphane Yönetim Sistemi — ortam değişkeni ŞABLONU
# =============================================================================
#  Bu dosya ŞABLONDUR ve Git tarafından izlenir. GERÇEK değerleri buraya YAZMAYIN.
#  Kullanım:  Copy-Item .env.example .env    (veya scripts\kurulum.ps1 otomatik yapar)
#  `.env` dosyası .gitignore içindedir ve asla depoya gönderilmez.
# =============================================================================

# ------------------------------------------------------------------ Uygulama
APP_ENV=development            # development | staging | production
DEBUG=true
HOST=127.0.0.1
# 8000 sık kullanılan bir porttur (Django, diğer yerel servisler); çakışma
# yaşanmaması için varsayılan 8010'dur.
PORT=8010
DEFAULT_LOCALE=tr

# ----------------------------------------------------------------- Güvenlik
# ÜRETİMDE MUTLAKA DOLDURUN. Boş bırakılırsa her başlatmada rastgele üretilir
# ve mevcut oturumlar geçersiz olur.
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Veritabanındaki API anahtarlarını şifreleyen ana anahtar.
# DİKKAT: Bu değer değişirse kayıtlı API anahtarları ÇÖZÜLEMEZ, yeniden girilmelidir.
SECRETS_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Üretimde yalnızca gerçek arayüz adreslerini yazın; "*" KULLANMAYIN.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.csv,.xlsx,.txt

# --------------------------------------------------------------- Veritabanı
# Boş bırakılırsa geliştirme için SQLite kullanılır: data/winery.db
# Üretim (PostgreSQL) biçimi — köşeli parantezli yerleri kendi değerlerinizle
# değiştirin. Parolayı ASLA bu şablon dosyasına yazmayın; yalnızca `.env` içine.
#   postgresql+asyncpg://[KULLANICI]:[PAROLA]@[SUNUCU]:5432/[VERITABANI]
DATABASE_URL=

# ------------------------------------------------------------- Yapay Zekâ
AI_ENABLED=true
AI_DEFAULT_PROVIDER=lmstudio
# Yerel modeller ilk çağrıda belleğe yüklenirken yavaş olabilir (8B model,
# 8 GB VRAM: ~50 sn). 300 sn güvenli bir varsayılandır.
# NOT: Bu değer YALNIZCA ilk kurulumda okunur; sonrasında sağlayıcı ayarı
# veritabanında tutulur ve Ayarlar ekranından değiştirilir.
AI_REQUEST_TIMEOUT_SECONDS=300
# Zaman aşımında yeniden deneme YAPILMAZ (bekleme süresini katlar);
# bu değer yalnızca ağ/sunucu hatalarında geçerlidir.
AI_MAX_RETRIES=1

# --- LM Studio (yerel, OpenAI uyumlu) — API anahtarı GEREKTİRMEZ ------------
# Veriler bilgisayardan çıkmaz; hassas veriler için önerilen sağlayıcıdır.
LMSTUDIO_ENABLED=true
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model kimliğini LM Studio'daki /v1/models listesinden alın; boşsa ayar
# ekranından seçebilirsiniz. Örnek: google/gemma-4-12b-qat
LMSTUDIO_MODEL=
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Anthropic Claude -------------------------------------------------------
# Anahtarı BURAYA yazabilir veya uygulama içi Ayarlar ekranından girebilirsiniz
# (ekrandan girilen anahtar şifrelenerek veritabanında saklanır).
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Model kimliği sabit varsayılmaz; güncel listeyi Ayarlar ekranından çekin.
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01

# --- NVIDIA Build (OpenAI uyumlu) ------------------------------------------
# Anahtar build.nvidia.com üzerinden oluşturulur ve `nvapi-` ile başlar.
NVIDIA_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# --- Ek OpenAI uyumlu sağlayıcı (isteğe bağlı) -----------------------------
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_NAME=openai-compat
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# ------------------------------------------------------- AI Terminali / Ajan
AGENT_ENABLED=true
# Ajanın yazabileceği TEK kök dizin. Dışına çıkış kod düzeyinde engellenir.
# Bos birakilirsa proje kok dizini kullanilir. Kendi yolunuzu yazacaksaniz
# MUTLAK bir yol verin (or. C:\Projeler\saraphane).
AGENT_WORKSPACE=
AGENT_COMMAND_TIMEOUT_SECONDS=180
AGENT_MAX_OUTPUT_BYTES=256000
# Üretimde KESİNLİKLE true bırakın.
AGENT_REQUIRE_APPROVAL=true

# --------------------------------------------------------------- Günlükleme
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false
# Gizli değerler (API anahtarı, parola, belirteç) günlüklere yazılmadan önce
# otomatik maskelenir; bkz. backend/app/core/logging.py

# ------------------------------------------------------------------- Demo
# Üretimde false yapın ve demo kullanıcıları silin.
SEED_DEMO_DATA=true
