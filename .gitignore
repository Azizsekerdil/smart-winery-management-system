# =============================================================================
#  Akıllı Şaraphane Yönetim Sistemi — Git yok sayma kuralları
#  İlke: gizli bilgi, kullanıcı verisi ve üretilen dosyalar depoya GİRMEZ.
# =============================================================================

# ------------------------------------------------------- GİZLİ BİLGİ (kritik)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
id_rsa*
*.crt
secrets.json
credentials.json
.secrets/
*.token
# Uygulamanin `.env` verilmediginde kendi urettigi kalici gizli anahtarlar.
# Veritabanindaki API anahtarlarinin sifrelemesi buna baglidir; asla paylasilmaz.
gizli-anahtarlar.json
data/gizli-anahtarlar.json
# Ilk kurulumda uretilen yonetici parolasi (bir kez gosterilir, sonra silinir).
ILK-GIRIS.txt
data/ILK-GIRIS.txt

# ---------------------------------------------------------------- Veritabanı
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/backups/
dump.rdb

# --------------------------------------------------- Kullanıcı verisi / yükler
data/uploads/
data/exports/
!data/.gitkeep
uploads/

# --------------------------------------------------------------- Günlükler
logs/
*.log
*.log.*

# ------------------------------------------------------------ Model dosyaları
# DIKKAT: Bu kural ANCAK depo kokundeki `/models/` dizinini kapsar.
# Cipasiz `models/` yazilirsa `backend/app/models/` (SQLAlchemy ORM katmani) da
# yok sayilir ve yayinlanan agac CALISMAZ - uygulama ice aktarilamaz.
/models/
!/models/.gitkeep
*.gguf
*.safetensors
*.bin
*.onnx
*.pt
*.pth

